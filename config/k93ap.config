# iPad 2 (K93AP) on top of p105ap.config.
#
# Sway and the other wlroots compositors want KMS, and simplefb is fbdev
# only.  simpledrm drives the same simple-framebuffer node -- the scanout
# iBoot leaves running -- as a DRM device, and keeps fbcon through the DRM
# fbdev emulation.  The two cannot share the node, so simplefb goes.
# CONFIG_FB_SIMPLE is not set
CONFIG_DRM_SIMPLEDRM=y
